{
    "name": "phurix/html",
    "description": "Phurix-maintained compatibility fork of LaravelCollective HTML for Laravel 12",
    "license": "MIT",
    "homepage": "https://github.com/phurix/html",
    "support": {
        "issues": "https://github.com/phurix/html/issues",
        "source": "https://github.com/phurix/html"
    },
    "authors": [
        {
            "name": "Adam Engebretson",
            "email": "adam@laravelcollective.com"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylorotwell@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/session": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/view": "^12.0"
    },
    "require-dev": {
        "illuminate/database": "^12.0",
        "mockery/mockery": "~1.0",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Collective\\Html\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Collective\\Html\\HtmlServiceProvider"
            ],
            "aliases": {
                "Form": "Collective\\Html\\FormFacade",
                "Html": "Collective\\Html\\HtmlFacade"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
